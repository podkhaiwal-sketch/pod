# Server
PORT=30000

# MongoDB (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/gali

# AWS (S3 / SDK used by server.js)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# IMB payment gateway
IMB_BASE_URL=https://secure-stage.imb.org.in
IMB_USER_TOKEN=
IMB_GET_SYNC_WEBHOOK_KEY=

# Roulette (ms interval, bet limits, win % → 100 = 2x payout on winning number only)
Roulette_Interval=30000
Roulette_Min_Bet=10
Roulette_Max_Bet=10000
Roulette_Win_Percentage=100
